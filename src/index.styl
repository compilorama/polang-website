@font-face
  font-family Inter
  font-style normal
  font-weight 400
  font-display optional
  src url('@src/fonts/Inter-Regular.woff2') format('woff2')

@font-face
  font-family Inter
  font-style normal
  font-weight 700
  font-display optional
  src url('@src/fonts/Inter-Bold.woff2') format('woff2')

html, body
  margin 0
  padding 0
  min-height 100vh
  font-family Inter, sans-serif
  font-size 18px
  font-feature-settings 'liga' 1, 'calt' 1

h1
  font-size 2.66666667rem
  text-align center
  letter-spacing -1px
  line-height 1
