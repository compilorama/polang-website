.pg-docs-link
  --pg-color-icon: var(--pg-color-lightest)
  display inline-flex
  align-items center
  justify-content center
  gap 0.625rem
  padding 12px 40px
  background-color var(--pg-color-primary)
  color var(--pg-color-lightest)
  font-weight 700
  font-size var(--pg-font-size-sm)
  text-decoration none
  border-radius 12px

  &:hover
    opacity 0.9

  .pg-icon
    width 24px
    height 24px
