.pg-layout
  position relative
  width 100%
  box-sizing border-box
  isolation isolate

.pg-layout-bg
  position fixed
  inset 0
  z-index 0
  width 100%
  height 100%
  object-fit cover
  opacity 0.2
  pointer-events none

.pg-layout-content-wrapper
  position relative
  z-index 1
  display flex
  flex-direction column
  align-items center
  justify-content center
  gap 3rem
  min-height 100vh
  min-height 100dvh
  width 100%
  padding 50px 40px
  box-sizing border-box

.pg-layout-content
  display flex
  flex-direction column
  align-items center
  justify-content center
  max-width 640px
  text-align center
